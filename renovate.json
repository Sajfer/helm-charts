{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "timezone": "Europe/Stockholm",
  "dependencyDashboard": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Image versions kept in appVersion, marked with a '# renovate: datasource=\u2026 depName=\u2026' comment",
      "managerFilePatterns": [
        "/(^|/)Chart\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\nappVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "linuxserver has old qbittorrent tags like 14.x and 20.04.1 (not qbittorrent versions); real ones are 5.x",
      "matchPackageNames": [
        "lscr.io/linuxserver/qbittorrent"
      ],
      "allowedVersions": "<10"
    }
  ]
}
